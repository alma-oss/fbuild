#!/usr/bin/env bash
# Ports this repo's local FAKE/Paket build engine (build/Utils.fs, build/Targets.fs, ...)
# onto the shared Alma.Build 4 package, gives the library spec its tests (Spec.library
# LibraryTests.dotNet, or noTests when the repo has none), then verifies with a full build.
# Run from anywhere inside a repo with a clean working tree. Undo with: git checkout -- . && git clean -fd

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -n "$(git status --porcelain)" ]; then
    echo "The working tree has uncommitted changes; commit or stash them first, so the undo cannot discard them." >&2
    exit 1
fi

pin="~> 4.0"
echo "- pin Alma.Build $pin"

# replace Fake dependencies with Alma.Build (perl -i edits in place the same way on Linux and macOS)
grep -q '^[[:space:]]*nuget Alma\.Build[[:space:]]' paket.dependencies ||
    PIN="$pin" perl -pi -e '$build = /^group Build$/ if /^group /; if ($build && !$done && /^(\s*)nuget Fake\./) { $_ = "$1nuget Alma.Build $ENV{PIN}\n$_"; $done = 1 }' paket.dependencies
grep -q '^[[:space:]]*Alma\.Build[[:space:]]*$' build/paket.references ||
    perl -pi -e '$_ .= "    Alma.Build\n" if /^group Build$/' build/paket.references
perl -ni -e '$build = /^group Build$/ if /^group /; print unless $build && /^\s*nuget Fake\./' paket.dependencies
perl -ni -e '$build = /^group Build$/ if /^group /; print unless $build && /^\s*Fake\./' build/paket.references

# delete original build modules
for file in Utils.fs Targets.fs Commands.fs Command.fs RtkFilter.fs SafeBuildHelpers.fs; do
    FILE="$file" perl -ni -e 'print unless /<Compile Include="\Q$ENV{FILE}\E" \/>/' build/build.fsproj
    rm -f "build/$file"
done

# remove header comment
awk 'BEGIN { header = 1 } header && (/^\/\// || /^[[:space:]]*$/) { next } { header = 0 } 1' \
    build/Build.fs > build/Build.fs.tmp && mv build/Build.fs.tmp build/Build.fs

# point import at Alma.Build
perl -pi -e 's/^open ProjectBuild$/open Alma.Build/' build/Build.fs

# Alma.Build 4 states a library's tests in its spec instead of defaulting them
if grep -q 'Spec\.defaultLibrary' build/Build.fs; then
    if compgen -G "tests/*.fsproj" > /dev/null; then
        tests="LibraryTests.dotNet"
    elif ! compgen -G "tests/*/*.fsproj" > /dev/null && ! compgen -G "tests/*/*/*.fsproj" > /dev/null; then
        tests="LibraryTests.noTests"
    else
        tests=""
        echo "- tests are not in tests/*.fsproj: replace Spec.defaultLibrary in build/Build.fs with Spec.library and the repo's LibraryTests (README, \"Library\")"
    fi
    if [ -n "$tests" ]; then
        TESTS="$tests" perl -pi -e 's/\bSpec\.defaultLibrary\b/Spec.library $ENV{TESTS}/' build/Build.fs
        echo "- library spec: Spec.library $tests"
    fi
fi

# remove Fake imports
perl -ni -e 'if (/^open Fake\./) { $fake = 1; next } if ($fake && /^$/) { $fake = 0; next } print' build/Build.fs

# clean files before rebuild
echo "- remove .paket"
rm -rf .paket

echo "- remove bin"
rm -rf build/bin/
rm -rf src/bin/
rm -rf tests/bin/

echo "- remove obj"
rm -rf obj/
rm -rf build/obj/
rm -rf src/obj/
rm -rf tests/obj/

echo "- remove .fake"
rm -rf .fake

echo "- remove .ionide"
rm -rf .ionide

echo "- remove packages"
rm -rf packages

echo "- remove paket-files"
rm -rf paket-files

echo "done"

dotnet tool restore
dotnet tool run paket install
dotnet build ./build/build.fsproj

dotnet run --no-build --project ./build/build.fsproj -- Bootstrap
dotnet run --no-build --project ./build/build.fsproj -- Solution
./build.sh Tests
